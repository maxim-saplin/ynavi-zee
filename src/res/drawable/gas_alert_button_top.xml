<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/tanker_buttonColorDisable" />
            <corners android:topLeftRadius="16.0dip" android:topRightRadius="16.0dip" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/tanker_buttonColorDisablePress" />
            <corners android:topLeftRadius="16.0dip" android:topRightRadius="16.0dip" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/alertBackgroundColor" />
            <corners android:topLeftRadius="16.0dip" android:topRightRadius="16.0dip" />
        </shape>
    </item>
</selector>
