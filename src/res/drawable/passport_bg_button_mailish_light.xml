<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="@color/passport_button_primary_light_pressed"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/passport_button_primary_light_pressed" />
                    <corners android:radius="@dimen/passport_next_widget_corner_radius" />
                </shape>
            </item>
            <item android:state_enabled="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/passport_button_primary_light" />
                    <corners android:radius="@dimen/passport_next_widget_corner_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/passport_button_mailish_light_disabled" />
                    <corners android:radius="@dimen/passport_next_widget_corner_radius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
