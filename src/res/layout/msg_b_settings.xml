<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.core.widget.NestedScrollView android:id="@id/scrollable_settings" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_below="@id/profile_toolbar_container">
        <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content">
            <com.yandex.bricks.BrickSlotView android:id="@id/profile_main_user_info_container" android:layout_width="fill_parent" android:layout_height="wrap_content" />
            <com.yandex.bricks.BrickSlotView android:id="@id/profile_main_user_phone_container" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" />
            <com.yandex.bricks.BrickSlotView android:id="@id/profile_organizations_container" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" />
            <com.yandex.bricks.BrickSlotView android:id="@id/disk_info_container" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" />
            <com.yandex.bricks.BrickSlotView android:id="@id/profile_notifications_switch_container" android:layout_width="fill_parent" android:layout_height="wrap_content" />
            <com.yandex.bricks.BrickSlotView android:id="@id/interface_container" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" />
            <com.yandex.bricks.BrickSlotView android:id="@id/profile_privacy_container" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" />
            <com.yandex.bricks.BrickSlotView android:id="@id/profile_address_book_container" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" />
            <com.yandex.bricks.BrickSlotView android:id="@id/profile_zero_screen_switch_container" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" />
            <TextView android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/messaging_settings_group_other" style="@style/Messaging.Settings.Text.Group" />
            <View android:background="@drawable/msg_divider_settings_group" android:layout_width="fill_parent" android:layout_height="2.0dip" />
            <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:divider="@drawable/msg_divider_settings_items" android:showDividers="middle">
                <com.yandex.bricks.BrickSlotView android:id="@id/feedback_button_container" android:layout_width="fill_parent" android:layout_height="wrap_content" />
                <TextView android:id="@id/messaging_profile_about_button" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/messaging_profile_settings_about" style="@style/Messaging.Settings.Item.Text" />
                <TextView android:id="@id/messaging_profile_debug_panel_button" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="Debug panel" style="@style/Messaging.Settings.Item.Text" />
                <TextView android:textColor="?messagingCommonDestructiveColor" android:id="@id/messaging_profile_exit_button" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/profile_logout_button_text" style="@style/Messaging.Settings.Item.Text" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
