<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <set>
            <objectAnimator android:duration="200" android:valueTo="5.0dip" android:valueType="floatType" android:propertyName="translationZ" />
        </set>
    </item>
    <item android:state_activated="false">
        <set>
            <objectAnimator android:duration="200" android:valueTo="0.0dip" android:valueType="floatType" android:propertyName="translationZ" />
        </set>
    </item>
</selector>
