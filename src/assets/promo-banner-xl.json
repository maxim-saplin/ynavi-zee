                                                                        "margins": {
                                                                            "top": 1,
                                                                            "bottom": 1,
                                                                            "left": 1,
                                                                            "right": 1
                                                                        },
                                                                        "paddings": {
                                                                            "top": 7,
                                                                            "bottom": 7,
                                                                            "left": 20,
                                                                            "right": 20
                                                                        },
                                                                        "text": "@{promo_banner_x_l_buttonText}",
                                                                        "text_color": "#fff",
                                                                        "width": {
                                                                            "type": "wrap_content"
                                                                        }
                                                                    }
                                                                ],
                                                                "width": {
                                                                    "type": "wrap_content"
                                                                }
                                                            }
                                                        ],
                                                        "margins": {
                                                            "top": 10,
                                                            "bottom": 16,
                                                            "left": 16,
                                                            "right": 16
                                                        },
                                                        "width": {
                                                            "type": "wrap_content"
                                                        }
                                                    }
                                                ]
                                            }
                                        },
                                        {
                                            "state_id": "topup",
                                            "div": {
                                                "type": "container",
                                                "items": [
                                                    {
                                                        "type": "container",
                                                        "alignment_vertical": "center",
                                                        "items": [
                                                            {
                                                                "type": "container",
                                                                "background": [
                                                                    {
                                                                        "colors": [
                                                                            "#66FFFFFF",
                                                                            "#01FFFFFF",
                                                                            "#01FFFFFF",
                                                                            "#1AFFFFFF"
                                                                        ],
                                                                        "angle": 272,
                                                                        "type": "gradient"
                                                                    }
                                                                ],
                                                                "border": {
                                                                    "corner_radius": 16
                                                                },
                                                                "height": {
                                                                    "type": "wrap_content"
                                                                },
                                                                "items": [
                                                                    {
                                                                        "type": "text",
                                                                        "action": {
                                                                            "log_id": "payment_sdk_promo_banner_x_l_promo_banner_x_l",
                                                                            "url": "promo-sdk://promo_banner_x_l/top_up_click"
                                                                        },
                                                                        "background": [
                                                                            {
                                                                                "colors": [
                                                                                    "#AC64D3",
                                                                                    "#BB6AC2"
                                                                                ],
                                                                                "angle": 0,
                                                                                "type": "gradient"
                                                                            }
                                                                        ],
                                                                        "border": {
                                                                            "corner_radius": 15
                                                                        },
                                                                        "font_size": 16,
                                                                        "font_size_unit": "dp",
                                                                        "font_weight": "bold",
                                                                        "margins": {
                                                                            "top": 1,
                                                                            "bottom": 1,
                                                                            "left": 1,
                                                                            "right": 1
                                                                        },
                                                                        "paddings": {
                                                                            "top": 7,
                                                                            "bottom": 7,
                                                                            "left": 20,
                                                                            "right": 20
                                                                        },
                                                                        "text": "@{promo_banner_x_l_buttonText}",
                                                                        "text_color": "#fff",
                                                                        "width": {
                                                                            "type": "wrap_content"
                                                                        }
                                                                    }
                                                                ],
                                                                "width": {
                                                                    "type": "wrap_content"
                                                                }
                                                            }
                                                        ],
                                                        "margins": {
                                                            "top": 10,
                                                            "bottom": 16,
                                                            "left": 16,
                                                            "right": 16
                                                        },
                                                        "width": {
                                                            "type": "wrap_content"
                                                        }
                                                    }
                                                ]
                                            }
                                        }
                                    ]
                                }
                            ],
                            "orientation": "vertical",
                            "width": {
                                "type": "match_parent"
                            }
                        }
                    ],
                    "orientation": "overlap",
                    "width": {
                        "type": "match_parent"
                    }
                }
            }
        ]
    }
}
