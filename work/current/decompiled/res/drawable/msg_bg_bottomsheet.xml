<?xml version="1.0" encoding="utf-8"?>
<layer-list android:paddingTop="@dimen/msg_bottomsheet_top_margin"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap android:gravity="center|top" android:src="?messagingBottomSheetPinDrawable" android:alpha="0.1" />
    </item>
    <item android:top="@dimen/msg_bottomsheet_top_margin">
        <shape android:shape="rectangle">
            <solid android:color="?messagingCommonBackgroundColor" />
            <corners android:topLeftRadius="@dimen/msg_bottomsheet_corner_radius" android:topRightRadius="@dimen/msg_bottomsheet_corner_radius" />
        </shape>
    </item>
</layer-list>
