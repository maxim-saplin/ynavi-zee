# Feature configuration for ynavi-zee (template)
# Copy to: features/config.env
# Notes:
# - Values are applied IN-PLACE to files under ./src/ before building.
# - Units:
#   - *_DIP are in dp/dip (decimal allowed)
#   - *_PERCENT are whole percent (e.g. 175 = 175%)
#

# MapActivity letterbox padding (top/bottom empty bands)
ZEEAPP_LETTERBOX_TOP_DIP=91.0
ZEEAPP_LETTERBOX_BOTTOM_DIP=91.0

# MapActivity letterbox padding (left empty band)
ZEEAPP_LETTERBOX_LEFT_DIP=380.0

# App-wide UI scale (density-based)
ZEEAPP_UI_SCALE_PERCENT=175

# Foreground-service keepalive (persistent notification required for FGS on Android 8+)
# 1 = enabled (service declared + started at launch), 0 = disabled
ZEEAPP_KEEPALIVE_ENABLED=1

# Debug/testing only: allow ADB to trigger KeepAliveTriggerReceiver (1=exported, 0=not exported)
ZEEAPP_KEEPALIVE_RECEIVER_EXPORTED_DEBUG=0
