# Feature configuration for ynavi-zee (template)
# Copy to: features/config.env
# Notes:
# - Values are applied IN-PLACE to files under ./src/ before building.
# - Units:
#   - *_DIP are in dp/dip (decimal allowed)
#   - *_PERCENT are whole percent (e.g. 175 = 175%)
#
# Zee (Zeekr margined) defaults below — match build_zeekr.sh.
# Deepal / OS7 presets live in build_deepal.sh / build_zeekr_os7.sh (do not
# bake their letterbox into this example; 0122: v30 stretch was wrongly built
# from an older 91/91/380 example and showed bottom bands instead of left).
#

# MapActivity letterbox padding (top/bottom empty bands)
ZEEAPP_LETTERBOX_TOP_DIP=70.0
ZEEAPP_LETTERBOX_BOTTOM_DIP=10.0

# MapActivity letterbox padding (left empty band)
ZEEAPP_LETTERBOX_LEFT_DIP=480.0

# App-wide UI scale (density-based)
ZEEAPP_UI_SCALE_PERCENT=175

# Map UI scale (in percent)
ZEEAPP_MAP_SCALE_PERCENT=130

# Ad banner surfaces (Yandex ads + monetization banner containers)
# 1 = enabled, 0 = collapsed/disabled in the rebuilt APK
ZEEAPP_ENABLE_AD_BANNERS=0

# Promo banner surfaces (search/placecard, tanker, and bank promo banners)
# 1 = enabled, 0 = collapsed/disabled in the rebuilt APK
ZEEAPP_ENABLE_PROMO_BANNERS=0

# Foreground-service keepalive (persistent notification required for FGS on Android 8+)
# 1 = enabled (service declared + started at launch), 0 = disabled
ZEEAPP_KEEPALIVE_ENABLED=1

# Keepalive mode (fgs|audio|off); when missing, defaults to fgs if keepalive is enabled
ZEEAPP_KEEPALIVE_MODE=fgs

# Debug/testing only: allow ADB to trigger KeepAliveTriggerReceiver (1=exported, 0=not exported)
ZEEAPP_KEEPALIVE_RECEIVER_EXPORTED_DEBUG=0
