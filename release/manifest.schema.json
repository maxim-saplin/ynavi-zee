{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maxim-saplin/ynavi-zee/release/manifest.schema.json",
  "title": "YNavi GitHub Release manifest",
  "type": "object",
  "required": [
    "schema_version",
    "repo",
    "tag",
    "channel",
    "upstream_version",
    "mod_build",
    "version_name",
    "version_code",
    "assets"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "repo": { "type": "string" },
    "tag": { "type": "string", "pattern": "^ynavi-zeekr-v[0-9]+\\.[0-9]+\\.[0-9]+\\+[0-9]+$" },
    "channel": { "type": "string", "enum": ["stable", "beta"] },
    "upstream_version": { "type": "string" },
    "mod_build": { "type": "integer", "minimum": 1 },
    "version_name": { "type": "string" },
    "version_code": { "type": "integer", "minimum": 1 },
    "git_commit": { "type": "string" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["variant_id", "filename", "sha256", "version_name", "version_code"],
        "properties": {
          "variant_id": { "type": "string" },
          "filename": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "version_name": { "type": "string" },
          "version_code": { "type": "integer" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
